# ===== Brokers =====
RABBITMQ_USER=rutaexpress
RABBITMQ_PASS=changeme
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

KAFKA_PORT=9092

# ===== Base de datos (PostgreSQL) =====
POSTGRES_USER=rutaexpress
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ===== Spring =====
# Perfiles activos en Docker. prod = PostgreSQL sin JWT (desarrollo local con compose).
# Producción: SPRING_PROFILES_ACTIVE=prod,secure (o ./ec2/deploy.sh --secure).
SPRING_PROFILES_ACTIVE=prod

# ===== Azure AD (IDaaS, perfil secure) =====
AZURE_TENANT_ID=<TENANT_ID>
# Los tokens v2 traen aud = GUID de la API (no api://...)
AZURE_API_AUDIENCE=<API_CLIENT_ID>

# ===== Frontend (Diego; build args) =====
VITE_TENANT_ID=<TENANT_ID>
VITE_SPA_CLIENT_ID=<SPA_CLIENT_ID>
VITE_API_SCOPE=api://<API_CLIENT_ID>/access_as_user
VITE_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# ===== Despliegue =====
EC2_HOST=
EC2_USER=ec2-user
